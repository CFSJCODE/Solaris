# Copie para .env e preencha com suas chaves
# O arquivo .env NUNCA deve ser commitado

# ── Banco de dados ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://solaris:solaris@localhost:5432/solaris

# ── LLM Providers ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# ── API interna ─────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8765
